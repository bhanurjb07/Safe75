# URL of the Supabase edge function that forwards requests to the college ERP
VITE_PROXY_URL=
# Public Supabase anon key for that function
VITE_SUPABASE_ANON_KEY=
# Attendance target in percent (default 75)
VITE_ATTENDANCE_TARGET=
# true = try loading past semesters' attendance (experimental, hidden automatically if unsupported)
VITE_ENABLE_PAST_SEMESTERS=
